# ==============================================================================
# Docker Compose Environment Template
# Copy this file to .env before running: docker-compose up -d --build
# ==============================================================================

# Supabase Credentials (from https://supabase.com/dashboard/project/<PROJECT_REF>/settings/api)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client Domain / URL (use http://localhost for local testing, or https://yourdomain.com for production)
CLIENT_URL=http://localhost

# Optional explicit Frontend Overrides
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
